# VS Code "Dark 2026" — matched to the editor's colors.
#
# Dark 2026 defines no terminal ANSI palette, so these 16 colors are VS Code's
# built-in default *dark* palette (from the compiled workbench). Unlike Light
# 2026, this theme *does* set terminal.* panel colors, so bg/cursor/selection
# come from those (terminal.background, terminalCursor.foreground,
# terminal.selectionBackground) and foreground falls back to editor.foreground.
# Regenerate by re-reading theme-defaults/themes/2026-dark.json + the dark
# branch of terminalColorRegistry defaults (BMt in workbench.desktop.main.js).

palette = 0=#000000
palette = 1=#cd3131
palette = 2=#0dbc79
palette = 3=#e5e510
palette = 4=#2472c8
palette = 5=#bc3fbc
palette = 6=#11a8cd
palette = 7=#e5e5e5
palette = 8=#666666
palette = 9=#f14c4c
palette = 10=#23d18b
palette = 11=#f5f543
palette = 12=#3b8eea
palette = 13=#d670d6
palette = 14=#29b8db
palette = 15=#e5e5e5

background = #191a1b
foreground = #bbbebf
cursor-color = #bfbfbf
# terminal.selectionBackground #3994BC at 20% over background #191A1B
selection-background = #1f323b
